# System files
.DS_Store
.Rproj.user
.Rhistory
.RData

# Large Data Files
# *.rds
*.RData
*.csv
*.rdata

# Enforce tracking of specific folders
!data/.gitkeep
!output/.gitkeep
!plots/.gitkeep

# Derived artifacts: exactly and cheaply reproducible from a tracked script, so
# they are kept out of git. The ERGM-imputed source networks
# (data/02_GSS_network_ergm, data/02_ATP_network_ergm) ARE tracked: those are
# expensive to refit.
#   data/02_GSS_DP_network/  <- scripts/04_make_DP_networks.R   (~3 min, seeded)
#   data/02_GSS_SH_network/  <- scripts/04b_make_SH_networks.R  (~1 min, seeded)
#   output/**/checkpoints/   <- simulation checkpoints          (~50 min, seeded)
data/02_GSS_DP_network/
data/02_GSS_SH_network/
output/**/checkpoints/
#   output/**/exposure_axis_*.rds <- scripts/05_unified_diffusion_sweep.R (compact sweep results)
output/**/exposure_axis_*.rds

# Figures of the 96 ERGM networks (annealed gate): local copies only, for comparison
# until PR #3 closes; the tracked versions stay in the git history
plots/**/_ergm96/

# Smoke-test sandboxes (--test) and the networks of the held-out validation
# (scripts/09_network_validation.R rebuilds them in ~2 min)
output/**/_test/
data/02_calibrated_networks/_test/
data/02_calibrated_networks/holdout/

# Ignore playground (scratch / exploratory work)
playground/

# Legacy engine (two-channel rule with exogenous tau) — kept locally only.
# See legacy/README.md; the code is recoverable from git history.
legacy/

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.blg

# Run logs (written with: Rscript ... 2>&1 | tee logs/<name>.log)
logs/

# Pre-fix results kept locally for before/after comparison
output/**/_prefix/

# Results produced while q was fed as propensity instead of aversion (pre-fix 2026-10-05)
output/**/_qinverted/

# Local Claude Code context (not shared)
CLAUDE.md
