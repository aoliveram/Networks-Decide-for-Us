\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textit  {Adoption Regimes and Phase Transition Signatures.} Top row: Average Total, Rational, and Social Adoption heatmaps. Bottom row (left): Susceptibility $\chi = \text  {Var}(\Phi )$ via the Fluctuation-Dissipation Theorem, with the phase boundary visible as a ridge of high variance. Bottom row (right): Standard Deviation of simulation relaxation time; its divergence is the signature of Critical Slowing Down. Simulations based on a GSS plausible network, $\tau _{sd}=0.12$, and random seeding (see Section S5 for equivalent signatures under degree-preserved randomized topologies).}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:criticality}{{1}{5}{\textit {Adoption Regimes and Phase Transition Signatures.} Top row: Average Total, Rational, and Social Adoption heatmaps. Bottom row (left): Susceptibility $\chi = \text {Var}(\Phi )$ via the Fluctuation-Dissipation Theorem, with the phase boundary visible as a ridge of high variance. Bottom row (right): Standard Deviation of simulation relaxation time; its divergence is the signature of Critical Slowing Down. Simulations based on a GSS plausible network, $\tau _{sd}=0.12$, and random seeding (see Section S5 for equivalent signatures under degree-preserved randomized topologies)}{figure.caption.3}{}}
