\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textit  {Adoption Regimes and Phase Transition Signatures.} Top row: Average Total, Rational, and Social Adoption heatmaps. Bottom row (left): Susceptibility $\chi = \text  {Var}(\Phi )$ via the Fluctuation-Dissipation Theorem, with the phase boundary visible as a ridge of high variance. Bottom row (right): Standard Deviation of simulation relaxation time; its divergence is the signature of Critical Slowing Down. Simulations based on a GSS plausible network, $\tau _{sd}=0.12$, and random seeding (see Section S5 for equivalent signatures under Erdős-Rényi topologies).}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:criticality}{{1}{5}{\textit {Adoption Regimes and Phase Transition Signatures.} Top row: Average Total, Rational, and Social Adoption heatmaps. Bottom row (left): Susceptibility $\chi = \text {Var}(\Phi )$ via the Fluctuation-Dissipation Theorem, with the phase boundary visible as a ridge of high variance. Bottom row (right): Standard Deviation of simulation relaxation time; its divergence is the signature of Critical Slowing Down. Simulations based on a GSS plausible network, $\tau _{sd}=0.12$, and random seeding (see Section S5 for equivalent signatures under Erdős-Rényi topologies)}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Super-critical susceptibility scaling across the GSS network. The $\gamma $ exponent extracted from the plausible networks logically converges to $\approx 1$, formally confirming that empirical clustering anchors the complex contagion to a continuous Universality Class. Randomizing the topology invariably disrupts this scaling into unphysical logarithmic cliffs.}}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:exponents}{{2}{6}{Super-critical susceptibility scaling across the GSS network. The $\gamma $ exponent extracted from the plausible networks logically converges to $\approx 1$, formally confirming that empirical clustering anchors the complex contagion to a continuous Universality Class. Randomizing the topology invariably disrupts this scaling into unphysical logarithmic cliffs}{figure.caption.4}{}}
